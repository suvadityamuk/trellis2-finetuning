{
    "ckpt": "microsoft/TRELLIS.2-4B/ckpts/ss_flow_img_dit_1_3B_64_bf16",
    "dataset": "ImageConditionedSparseStructureLatent",
    "dataset_args": {
        "min_aesthetic_score": 4.5,
        "image_size": 512
    },
    "sparse": false,
    "t_schedule": {
        "name": "logitNormal",
        "args": {
            "mean": 1.0,
            "std": 1.0
        }
    },
    "sigma_min": 1e-5,
    "p_uncond": 0.1,
    "image_cond_model": "facebook/dinov3-vitl16-pretrain-lvd1689m",
    "image_size": 512,
    "rank": 8,
    "alpha": 16,
    "lora_targets": ["to_qkv", "to_out", "to_q", "to_kv", "mlp.mlp.0", "mlp.mlp.2"],
    "use_checkpoint": true,
    "lr": 1e-4,
    "weight_decay": 0.01,
    "grad_clip": 1.0,
    "batch_size": 4,
    "grad_accum": 4,
    "num_workers": 4,
    "max_steps": 3000,
    "i_log": 10,
    "i_save": 500,
    "seed": 0
}
